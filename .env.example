# Next.js server: copy this file to apps/web/.env.local (restart Next.js on changes).
API_URL=http://127.0.0.1:8000

# FastAPI: export these in the API shell; Next.js does not export them to Python.
RAGLAB_DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
# Default model for Phase 1 chunk previews and the legacy /search endpoint only:
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional model-cache location (first use downloads the pinned public weights).
# HF_HOME=/absolute/path/to/model-cache
# HF_HUB_OFFLINE=1

# Optional grounded generation: OpenAI-compatible Chat Completions API.
# Retrieval works without ANY of these credentials.
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# OPENAI_API_KEY is accepted as a fallback. Never use NEXT_PUBLIC_ for a key.
LLM_REQUIRE_KEY=true
# For an explicitly trusted local OpenAI-compatible server without authentication:
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model
# LLM_REQUIRE_KEY=false

# Phase 3 retrieval benchmarks need no external provider credentials.
# Optional browser smoke-test settings (disposable test data only):
# RAGLAB_PYTHON=/absolute/path/to/.venv/bin/python
# RAGLAB_E2E_DATA_DIR=./work/e2e-data
